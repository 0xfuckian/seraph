# ============================================================
# Seraph Protocol — Presale Deployment Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Then source it before running the deployment script:
#   source .env
#   forge script script/DeployPresale.s.sol:DeployPresale \
#       --rpc-url $BASE_RPC_URL \
#       --broadcast \
#       --verify \
#       -vvvv
# ============================================================

# ── Required ──────────────────────────────────────────────────

# Deployer private key (without 0x prefix)
PRIVATE_KEY=

# Base mainnet RPC URL (Alchemy, Infura, or public endpoint)
BASE_RPC_URL=https://mainnet.base.org

# TGE unix timestamp (e.g., 1735689600 for Jan 1 2025 00:00:00 UTC)
TGE_TIMESTAMP=

# ── Optional (defaults shown) ────────────────────────────────

# Treasury wallet address (defaults to deployer if unset)
# TREASURY_ADDRESS=0x...

# USDT contract address on Base
# Default: 0x0000000000000000000000000000000000000001 (placeholder — update for production)
# USDT_ADDRESS=0x0000000000000000000000000000000000000001

# USDC contract address on Base (native USDC)
# Default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ETH/USD price for the presale's ETH pricing (plain USD, no decimals)
# Default: 2000
# ETH_USD_PRICE=2000

# ── Etherscan / Basescan Verification ────────────────────────

# Basescan API key for contract verification
# BASESCAN_API_KEY=
