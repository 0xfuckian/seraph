# ==============================================================================
# Seraph Protocol — BookStack Instance Environment Configuration
# ==============================================================================

# Application URL (Use your domain or public IP in production)
# e.g., https://docs.seraphprotocol.tech or http://YOUR_VPS_IP:6875
APP_URL=http://localhost:6875
APP_PORT=6875

# Database Configuration
DB_NAME=bookstack
DB_USER=bookstack
DB_PASSWORD=replace_with_a_secure_database_password
DB_ROOT_PASSWORD=replace_with_a_secure_mariadb_root_password

# Timezone
TZ=Etc/UTC
